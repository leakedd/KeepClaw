<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- En-tête : marque + état du moteur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_header"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_core"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/detail_offline"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingEnd="11dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:text="@string/status_idle"
                android:textColor="@color/text_soft"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Contrôles du moteur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_header"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <ImageButton
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn"
            android:src="@drawable/ic_play"
            android:tint="@color/text_soft"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:contentDescription="@string/btn_start" />

        <ImageButton
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn"
            android:src="@drawable/ic_stop"
            android:tint="@color/text_soft"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:contentDescription="@string/btn_stop" />

        <ImageButton
            android:id="@+id/btn_reload"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn"
            android:src="@drawable/ic_sync"
            android:tint="@color/text_soft"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:contentDescription="@string/btn_reload" />

        <ImageButton
            android:id="@+id/btn_battery"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn"
            android:src="@drawable/ic_battery"
            android:tint="@color/text_soft"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:contentDescription="@string/btn_battery" />

        <ImageButton
            android:id="@+id/btn_wipe"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn"
            android:src="@drawable/ic_delete"
            android:tint="@color/danger"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:contentDescription="@string/btn_wipe" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
