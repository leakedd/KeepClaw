+// adoptHealthyGateway attaches to a gateway that already listens on the
+// configured port even when its pid file is unavailable or was ignored (for
+// example after a reset). The health endpoint is the source of truth: only a
+// responsive gateway is adopted, never a foreign listener.
+func (h *Handler) adoptHealthyGateway() (int, bool) {
+	gateway.mu.Lock()
+	tracked := gateway.cmd != nil && gateway.cmd.Process != nil && isCmdProcessAliveLocked(gateway.cmd)
+	gateway.mu.Unlock()
+	if tracked {
+		return 0, false
+	}
+
+	cfg, err := config.LoadConfig(h.configPath)
+	if err != nil {
+		return 0, false
+	}
+
+	port := 18790
+	if cfg != nil && cfg.Gateway.Port != 0 {
+		port = cfg.Gateway.Port
+	}
+	host := gatewayProbeHost(h.effectiveGatewayBindHost(cfg))
+	if !gatewayPortProbe(host, port, gatewayAdoptDialTimeout) {
+		return 0, false
+	}
+
+	resp, statusCode, err := h.getGatewayHealth(cfg, gatewayAdoptHealthTimeout)
+	if err != nil || resp == nil || statusCode != http.StatusOK || resp.PID <= 0 {
+		return 0, false
+	}
+
+	gateway.mu.Lock()
+	defer gateway.mu.Unlock()
+	if gateway.cmd != nil && gateway.cmd.Process != nil && isCmdProcessAliveLocked(gateway.cmd) {
+		return gateway.cmd.Process.Pid, true
+	}
+	if attachErr := attachToGatewayProcessLocked(resp.PID, cfg); attachErr != nil {
+		logger.WarnC("gateway", fmt.Sprintf(
+			"Found healthy gateway (PID %d) but could not attach: %v",
+			resp.PID,
+			attachErr,
+		))
+		return 0, false
+	}
+	gateway.pidData = &ppid.PidFileData{
+		PID:  resp.PID,
+		Port: port,
+		Host: h.effectiveGatewayBindHost(cfg),
+	}
+	logger.InfoC("gateway", fmt.Sprintf("Adopted healthy gateway (PID: %d)", resp.PID))
+	return resp.PID, true
+}
