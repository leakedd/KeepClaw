+func swapGatewayPortHooks(
+	t *testing.T,
+	listen func(int) []int,
+	owned func(int) bool,
+	signal func(int, syscall.Signal) error,
+) {
+	t.Helper()
+	prevListen, prevOwned, prevSignal := gatewayListeningPids, gatewayOwnedProcess, gatewaySignalProcess
+	prevWait, prevPeriod := gatewayPortFreeWait, gatewayPortPollPeriod
+	gatewayListeningPids, gatewayOwnedProcess, gatewaySignalProcess = listen, owned, signal
+	gatewayPortFreeWait, gatewayPortPollPeriod = 20*time.Millisecond, 2*time.Millisecond
+	t.Cleanup(func() {
+		gatewayListeningPids, gatewayOwnedProcess, gatewaySignalProcess = prevListen, prevOwned, prevSignal
+		gatewayPortFreeWait, gatewayPortPollPeriod = prevWait, prevPeriod
+	})
+}
