+func TestReleaseStaleGatewayPortTerminatesOwnedProcess(t *testing.T) {
+	listening := true
+	var signals []syscall.Signal
+	swapGatewayPortHooks(t,
+		func(int) []int {
+			if listening {
+				return []int{4242}
+			}
+			return nil
+		},
+		func(pid int) bool { return pid == 4242 },
+		func(pid int, sig syscall.Signal) error {
+			signals = append(signals, sig)
+			if sig == syscall.SIGTERM {
+				listening = false
+			}
+			return nil
+		},
+	)
+
+	h := &Handler{}
+	h.releaseStaleGatewayPort(&config.Config{Gateway: config.GatewayConfig{Port: 18790}})
+
+	if len(signals) != 1 || signals[0] != syscall.SIGTERM {
+		t.Fatalf("signals = %v, want [SIGTERM]", signals)
+	}
+}
