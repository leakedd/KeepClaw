+// portAcceptsConnections reports whether something is listening on host:port.
+func portAcceptsConnections(host string, port int, timeout time.Duration) bool {
+	if port <= 0 {
+		return false
+	}
+	if strings.TrimSpace(host) == "" {
+		host = netbind.ResolveAdaptiveLoopbackHost()
+	}
+	conn, err := net.DialTimeout("tcp", net.JoinHostPort(host, strconv.Itoa(port)), timeout)
+	if err != nil {
+		return false
+	}
+	_ = conn.Close()
+	return true
+}
