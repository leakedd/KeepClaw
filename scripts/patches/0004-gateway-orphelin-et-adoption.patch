+// listeningPidsOnPort returns the PIDs listening on the given TCP port,
+// including loopback. It uses /proc on Linux/Android and falls back to lsof.
+func listeningPidsOnPort(port int) []int {
+	if port <= 0 {
+		return nil
+	}
+	if inodes := procListenInodes(port); len(inodes) > 0 {
+		return pidsForSocketInodes(inodes)
+	}
+	return lsofListeningPids(port)
+}
+
+func procListenInodes(port int) []uint64 {
+	var inodes []uint64
+	for _, path := range []string{"/proc/net/tcp", "/proc/net/tcp6"} {
+		data, err := os.ReadFile(path)
+		if err != nil {
+			continue
+		}
+		inodes = append(inodes, parseProcNetListeners(string(data), port)...)
+	}
+	return inodes
+}
+
+// parseProcNetListeners extracts socket inodes of LISTEN sockets on port from
+// /proc/net/tcp(6) content.
+func parseProcNetListeners(data string, port int) []uint64 {
+	var inodes []uint64
+	for i, line := range strings.Split(data, "\n") {
+		if i == 0 {
+			continue // header
+		}
+		fields := strings.Fields(line)
+		if len(fields) < 10 || fields[3] != "0A" {
+			continue
+		}
+		_, portHex, found := strings.Cut(fields[1], ":")
+		if !found {
+			continue
+		}
+		value, err := strconv.ParseInt(portHex, 16, 32)
+		if err != nil || int(value) != port {
+			continue
+		}
+		inode, err := strconv.ParseUint(fields[9], 10, 64)
+		if err != nil || inode == 0 {
+			continue
+		}
+		inodes = append(inodes, inode)
+	}
+	return inodes
+}
+
+func pidsForSocketInodes(inodes []uint64) []int {
+	if len(inodes) == 0 {
+		return nil
+	}
+	wanted := make(map[string]struct{}, len(inodes))
+	for _, inode := range inodes {
+		wanted["socket:["+strconv.FormatUint(inode, 10)+"]"] = struct{}{}
+	}
+
+	entries, err := os.ReadDir("/proc")
+	if err != nil {
+		return nil
+	}
+
+	var pids []int
+	for _, entry := range entries {
+		pid, err := strconv.Atoi(entry.Name())
+		if err != nil || pid <= 0 {
+			continue
+		}
+		fdDir := filepath.Join("/proc", entry.Name(), "fd")
+		fds, err := os.ReadDir(fdDir)
+		if err != nil {
+			continue
+		}
+		for _, fd := range fds {
+			target, err := os.Readlink(filepath.Join(fdDir, fd.Name()))
+			if err != nil {
+				continue
+			}
+			if _, ok := wanted[target]; ok {
+				pids = append(pids, pid)
+				break
+			}
+		}
+	}
+	return pids
+}
+
+// isOwnGatewayProcess reports whether pid runs under the current user and
+// looks like a gateway command line.
+func isOwnGatewayProcess(pid int) bool {
+	if pid <= 0 {
+		return false
+	}
+	if cmdline, ok := procCmdline(pid); ok {
+		if !procOwnedByCurrentUser(pid) {
+			return false
+		}
+		return looksLikeGatewayCommandLine(cmdline)
+	}
+	likely, inspected := gatewayProcessMatcher(pid)
+	return inspected && likely
+}
+
+func procCmdline(pid int) (string, bool) {
+	data, err := os.ReadFile(filepath.Join("/proc", strconv.Itoa(pid), "cmdline"))
+	if err != nil || len(data) == 0 {
+		return "", false
+	}
+	parts := bytes.Split(bytes.TrimRight(data, "\x00"), []byte{0})
+	fields := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if len(part) > 0 {
+			fields = append(fields, string(part))
+		}
+	}
+	return strings.Join(fields, " "), true
+}
+
+func procOwnedByCurrentUser(pid int) bool {
+	data, err := os.ReadFile(filepath.Join("/proc", strconv.Itoa(pid), "status"))
+	if err != nil {
+		return false
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		if !strings.HasPrefix(line, "Uid:") {
+			continue
 		}
+		fields := strings.Fields(strings.TrimPrefix(line, "Uid:"))
+		if len(fields) == 0 {
+			return false
+		}
+		uid, err := strconv.Atoi(fields[0])
+		return err == nil && uid == os.Getuid()
 	}
 	return false
 }
 
+func signalGatewayProcess(pid int, sig syscall.Signal) error {
+	return syscall.Kill(pid, sig)
+}
+
+func lsofListeningPids(port int) []int {
+	out, err := launcherExecCommand(
+		"lsof",
+		"-nP",
+		fmt.Sprintf("-iTCP:%d", port),
+		"-sTCP:LISTEN",
+		"-t",
+	).Output()
+	if err != nil {
+		return nil
+	}
+	var pids []int
+	for _, line := range strings.Split(string(out), "\n") {
+		if pid, err := strconv.Atoi(strings.TrimSpace(line)); err == nil && pid > 0 {
+			pids = append(pids, pid)
+		}
+	}
+	return pids
+}
