+// releaseStaleGatewayPort terminates a leftover gateway process that still
+// listens on the configured port while the launcher no longer tracks it (for
+// example after a reset or a launcher restart cleared picoclaw.pid.json).
+// Without this, starting the gateway fails with "address already in use" while
+// the UI keeps showing "stopped".
+func (h *Handler) releaseStaleGatewayPort(cfg *config.Config) {
+	if cfg == nil {
+		return
+	}
+	port := cfg.Gateway.Port
+	if port <= 0 {
+		return
+	}
+
+	var terminated []int
+	for _, pid := range gatewayListeningPids(port) {
+		if pid <= 0 || pid == os.Getpid() || !gatewayOwnedProcess(pid) {
+			continue
+		}
+		logger.WarnC("gateway", fmt.Sprintf(
+			"Terminating stale gateway process (PID %d) holding port %d",
+			pid,
+			port,
+		))
+		if err := gatewaySignalProcess(pid, syscall.SIGTERM); err != nil {
+			logger.WarnC("gateway", fmt.Sprintf("Failed to terminate stale gateway PID %d: %v", pid, err))
+			continue
+		}
+		terminated = append(terminated, pid)
+	}
+	if len(terminated) == 0 {
+		return
+	}
+
+	if waitForPortRelease(port) {
+		return
+	}
+	for _, pid := range terminated {
+		if err := gatewaySignalProcess(pid, syscall.SIGKILL); err == nil {
+			logger.WarnC("gateway", fmt.Sprintf("Force-killed stale gateway PID %d", pid))
+		}
+	}
+	if !waitForPortRelease(port) {
+		logger.ErrorC("gateway", fmt.Sprintf(
+			"Port %d is still busy after terminating the stale gateway process",
+			port,
+		))
+	}
+}
+
+func waitForPortRelease(port int) bool {
+	deadline := time.Now().Add(gatewayPortFreeWait)
+	for {
+		if len(gatewayListeningPids(port)) == 0 {
+			return true
+		}
+		if !time.Now().Before(deadline) {
+			return false
+		}
+		time.Sleep(gatewayPortPollPeriod)
+	}
+}
