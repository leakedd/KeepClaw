+func TestParseProcNetListeners(t *testing.T) {
+	// Port 18790 = 0x4966, port 18800 = 0x4970.
+	data := strings.Join([]string{
+		"  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode",
+		"   0: 0100007F:4966 00000000:0000 0A 00000000:00000000 00:00000000 00000000 10356        0 4142830 1 0000000000000000 100 0 0 10 0",
+		"   1: 0100007F:4970 00000000:0000 0A 00000000:00000000 00:00000000 00000000 10356        0 4156405 1 0000000000000000 100 0 0 10 0",
+		"   2: 0100007F:4966 0100007F:E188 01 00000000:00000000 02:000001D0 00000000 10356        0 4142831 3 0000000000000000 20 4 31 10 -1",
+	}, "\n")
+
+	inodes := parseProcNetListeners(data, 18790)
+	if len(inodes) != 1 || inodes[0] != 4142830 {
+		t.Fatalf("parseProcNetListeners(18790) = %v, want [4142830]", inodes)
+	}
+	if got := parseProcNetListeners(data, 18791); len(got) != 0 {
+		t.Fatalf("parseProcNetListeners(18791) = %v, want none", got)
+	}
+}
+
+func TestParseProcNetListenersIgnoresGarbage(t *testing.T) {
+	for _, data := range []string{"", "header only", "\x00\x01 not a table", "1: malformed"} {
+		if got := parseProcNetListeners(data, 18790); len(got) != 0 {
+			t.Fatalf("parseProcNetListeners(%q) = %v, want none", data, got)
+		}
+	}
+}
