+// withDefaultProviderHeaders returns a shallow copy of cfg whose CustomHeaders
+// include the provider's default headers. Explicit model headers win over
+// provider defaults, and the original cfg is never mutated.
+func withDefaultProviderHeaders(cfg *config.ModelConfig, protocol string) *config.ModelConfig {
+	defaults := DefaultHeadersFor(protocol)
+	if len(defaults) == 0 {
+		return cfg
+	}
+
+	merged := make(map[string]string, len(defaults)+len(cfg.CustomHeaders))
+	for name, value := range defaults {
+		merged[name] = value
+	}
+	for name, value := range cfg.CustomHeaders {
+		merged[name] = value
+	}
+
+	clone := *cfg
+	clone.CustomHeaders = merged
+	return &clone
 }
 
