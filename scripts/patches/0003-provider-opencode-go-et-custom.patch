+// DefaultHeadersFor returns a copy of the provider's default HTTP headers.
+// It returns nil when the provider is unknown or defines no default headers.
+func DefaultHeadersFor(provider string) map[string]string {
+	option, ok := modelProviderOptionForName(provider)
+	if !ok || len(option.DefaultHeaders) == 0 {
+		return nil
+	}
+	headers := make(map[string]string, len(option.DefaultHeaders))
+	for name, value := range option.DefaultHeaders {
+		headers[name] = value
+	}
+	return headers
+}
