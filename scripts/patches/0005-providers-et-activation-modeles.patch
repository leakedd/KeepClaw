+func TestConfigSignatureIncludesModelRuntimeChanges(t *testing.T) {
+	cfg := config.DefaultConfig()
+	cfg.ModelList = []*config.ModelConfig{
+		{
+			ModelName: "alpha",
+			Provider:  "opencode-go",
+			Model:     "alpha-model",
+			APIBase:   "https://example.com/v1",
+			APIKeys:   config.SimpleSecureStrings("sk-alpha"),
+		},
+	}
+	cfg.Agents.Defaults.ModelName = "alpha"
+
+	base := computeConfigSignature(cfg)
+
+	cfg.ModelList = append(cfg.ModelList, &config.ModelConfig{
+		ModelName: "beta",
+		Provider:  "opencode-go",
+		Model:     "beta-model",
+		APIBase:   "https://example.com/v1",
+		APIKeys:   config.SimpleSecureStrings("sk-beta"),
+	})
+	withModel := computeConfigSignature(cfg)
+	if withModel == base {
+		t.Fatal("config signature should change when a model is added")
+	}
+
+	cfg.ModelList[0].APIKeys = config.SimpleSecureStrings("sk-alpha-fixed")
+	withKey := computeConfigSignature(cfg)
+	if withKey == withModel {
+		t.Fatal("config signature should change when an API key changes")
+	}
+
+	cfg.ModelList[0].CustomHeaders = map[string]string{"x-opencode-session": "keepclaw"}
+	withHeaders := computeConfigSignature(cfg)
+	if withHeaders == withKey {
+		t.Fatal("config signature should change when custom headers change")
+	}
+
+	cfg.ModelList[0].ChatDisabled = true
+	withChatToggle := computeConfigSignature(cfg)
+	if withChatToggle != withHeaders {
+		t.Fatal("config signature should not change when only chat_disabled changes")
+	}
+}
