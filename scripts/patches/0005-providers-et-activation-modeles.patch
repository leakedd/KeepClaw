+// computeModelRuntimeSignatures returns a stable per-model signature for the
+// fields that are baked into the gateway's in-memory providers at startup
+// (model list, endpoints, credentials and custom headers). A gateway restart
+// is required when any of them change while it is running.
+func computeModelRuntimeSignatures(cfg *config.Config) []string {
+	if cfg == nil {
+		return nil
+	}
+	signatures := make([]string, 0, len(cfg.ModelList))
+	for _, model := range cfg.ModelList {
+		if model == nil {
+			continue
+		}
+		keyHash := "none"
+		if key := strings.TrimSpace(model.APIKey()); key != "" {
+			sum := sha256.Sum256([]byte(key))
+			keyHash = hex.EncodeToString(sum[:])[:12]
+		}
+		headers := "none"
+		if len(model.CustomHeaders) > 0 {
+			if data, err := json.Marshal(canonicalizeSignatureValue(reflect.ValueOf(model.CustomHeaders))); err == nil {
+				headers = string(data)
+			}
+		}
+		signatures = append(signatures, strings.Join([]string{
+			strings.TrimSpace(model.ModelName),
+			strings.TrimSpace(model.Provider),
+			strings.TrimSpace(model.Model),
+			strings.TrimSpace(model.APIBase),
+			keyHash,
+			headers,
+		}, "|"))
+	}
 	return signatures
 }
 
