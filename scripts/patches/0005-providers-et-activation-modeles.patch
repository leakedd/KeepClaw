+import { IconLoader2, IconSearch, IconSettings } from "@tabler/icons-react"
+import { useCallback, useEffect, useMemo, useState } from "react"
+import { useTranslation } from "react-i18next"
+import { toast } from "sonner"
+
+import { type ModelInfo, type ModelProviderOption, getModels } from "@/api/models"
+import { PageHeader } from "@/components/page-header"
+import { ProviderIcon } from "@/components/models/provider-icon"
+import {
+  type ProviderCatalogEntry,
+  getCanonicalProviderKey,
+  getProviderCatalogMap,
+} from "@/components/models/provider-registry"
+import { Badge } from "@/components/ui/badge"
+
+import { Input } from "@/components/ui/input"
+
+import { ProviderConfigureSheet } from "./provider-configure-sheet"
+
+export function ProvidersPage() {
+  const { t } = useTranslation()
+  const [loading, setLoading] = useState(true)
+  const [models, setModels] = useState<ModelInfo[]>([])
+  const [options, setOptions] = useState<ModelProviderOption[]>([])
+  const [filter, setFilter] = useState("")
+  const [active, setActive] = useState<ProviderCatalogEntry | null>(null)
+
+  const load = useCallback(async () => {
+    setLoading(true)
+    try {
+      const data = await getModels()
+      setModels(data.models)
+      setOptions(data.provider_options ?? [])
+    } catch (e) {
+      toast.error(e instanceof Error ? e.message : t("models.loadError"))
+    } finally {
+      setLoading(false)
+    }
+  }, [t])
+
+  useEffect(() => {
+    void load()
+  }, [load])
+
+  const catalog = useMemo(() => getProviderCatalogMap(options), [options])
+
+  const providers = useMemo(() => {
+    const list = [...catalog.values()]
+      .filter((p) => p.createAllowed)
+      .sort(
+        (a, b) => b.priority - a.priority || a.label.localeCompare(b.label),
+      )
+    const query = filter.trim().toLowerCase()
+    if (!query) return list
+    return list.filter(
+      (p) =>
+        p.label.toLowerCase().includes(query) ||
+        p.key.toLowerCase().includes(query),
+    )
+  }, [catalog, filter])
+
+  const countsByProvider = useMemo(() => {
+    const counts = new Map<string, number>()
+    for (const model of models) {
+      const key = getCanonicalProviderKey(model.provider, options)
+      if (!key) continue
+      counts.set(key, (counts.get(key) ?? 0) + 1)
+    }
+    return counts
+  }, [models, options])
+
+  const keySourceIndexByProvider = useMemo(() => {
+    const sources = new Map<string, { index: number; hasKey: boolean }>()
+    for (const model of models) {
+      const key = getCanonicalProviderKey(model.provider, options)
+      if (!key) continue
+      const hasKey = Boolean(model.api_key)
+      const current = sources.get(key)
+      if (!current || (!current.hasKey && hasKey)) {
+        sources.set(key, { index: model.index, hasKey })
+      }
+    }
+    return sources
+  }, [models, options])
+
+  return (
+    <div className="flex h-full flex-col">
+      <PageHeader title={t("providers.title")}>
+        <div className="relative">
+          <IconSearch className="text-muted-foreground absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2" />
+          <Input
+            value={filter}
+            onChange={(e) => setFilter(e.target.value)}
+            placeholder={t("providers.searchPlaceholder")}
+            className="h-8 w-[220px] pl-8"
+          />
+        </div>
+      </PageHeader>
+
+      <div className="flex-1 overflow-y-auto px-6 pb-8">
+        <p className="text-muted-foreground mb-4 max-w-2xl text-sm">
+          {t("providers.description")}
+        </p>
+
+        {loading && (
+          <div className="flex items-center justify-center py-20">
+            <IconLoader2 className="text-muted-foreground size-6 animate-spin" />
+          </div>
+        )}
+
+        {!loading && (
+          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
+            {providers.map((provider) => {
+              const count = countsByProvider.get(provider.key) ?? 0
+              return (
+                <button
+                  key={provider.key}
+                  type="button"
+                  onClick={() => setActive(provider)}
+                  className="border-border/60 bg-card hover:bg-muted/30 flex w-full items-center gap-3 rounded-xl border p-4 text-left transition-colors hover:shadow-xs"
+                >
+                  <span className="text-foreground flex min-w-0 flex-1 items-center gap-2 text-sm font-semibold">
+                    <ProviderIcon provider={provider} />
+                    <span className="truncate">{provider.label}</span>
+                  </span>
+                  {count > 0 ? (
+                    <Badge variant="secondary" className="shrink-0 text-[10px]">
+                      {t("providers.modelsCount", { count })}
+                    </Badge>
+                  ) : (
+                    <Badge
+                      variant="outline"
+                      className="text-muted-foreground shrink-0 text-[10px]"
+                    >
+                      {t("providers.noModels")}
+                    </Badge>
+                  )}
+                  <IconSettings className="text-muted-foreground size-4 shrink-0" />
+                </button>
+              )
+            })}
+          </div>
+        )}
+
+        {!loading && providers.length === 0 && (
+          <p className="text-muted-foreground py-10 text-center text-sm">
+            {t("providers.empty")}
+          </p>
+        )}
+      </div>
+
+      {active && (
+        <ProviderConfigureSheet
+          provider={active}
+          existingModelIDs={new Set(
+            models
+              .filter(
+                (m) =>
+                  getCanonicalProviderKey(m.provider, options) === active.key,
+              )
+              .map((m) => m.model),
+          )}
+          providerModelIndex={keySourceIndexByProvider.get(active.key)?.index}
+          modelCount={countsByProvider.get(active.key) ?? 0}
+          onClose={() => setActive(null)}
+          onSaved={() => {
+            void load()
+          }}
+        />
+      )}
+    </div>
+  )
+}
