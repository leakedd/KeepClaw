+// effectiveModelAPIBase returns the model's configured API base, falling back
+// to the provider's default base when none is set.
+func effectiveModelAPIBase(m *config.ModelConfig) string {
+	if m == nil {
+		return ""
+	}
+	if base := strings.TrimSpace(m.APIBase); base != "" {
+		return base
+	}
+	provider, _ := providers.ExtractProtocol(m)
+	return providers.DefaultAPIBaseForProtocol(provider)
