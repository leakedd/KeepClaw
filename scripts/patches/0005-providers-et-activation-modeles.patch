+import {
+  IconLoader2,
+  IconPlugConnected,
+  IconTrash,
+} from "@tabler/icons-react"
+import { useCallback, useEffect, useState } from "react"
+import { useTranslation } from "react-i18next"
+import { toast } from "sonner"
+
+import {
+  type UpstreamModel,
+  addModel,
+  deleteProvider,
+  fetchUpstreamModels,
+} from "@/api/models"
+import type { ProviderCatalogEntry } from "@/components/models/provider-registry"
+import { Field } from "@/components/shared-form"
+import {
+  AlertDialog,
+  AlertDialogAction,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from "@/components/ui/alert-dialog"
+import { Button } from "@/components/ui/button"
+import { Input } from "@/components/ui/input"
+import {
+  Sheet,
+  SheetContent,
+  SheetDescription,
+  SheetFooter,
+  SheetHeader,
+  SheetTitle,
+} from "@/components/ui/sheet"
+import { showSaveSuccessOrRestartToast } from "@/lib/restart-required"
+import { refreshGatewayState } from "@/store/gateway"
+
+interface ProviderConfigureSheetProps {
+  provider: ProviderCatalogEntry
+  existingModelIDs: Set<string>
+  providerModelIndex?: number
+  modelCount: number
+  onClose: () => void
+  onSaved: () => void
+}
+
+type Phase = "idle" | "fetching" | "adding"
+
+export function ProviderConfigureSheet({
+  provider,
+  existingModelIDs,
+  providerModelIndex,
+  modelCount,
+  onClose,
+  onSaved,
+}: ProviderConfigureSheetProps) {
+  const { t } = useTranslation()
+  const [apiKey, setApiKey] = useState("")
+  const [apiBase, setApiBase] = useState(provider.defaultApiBase ?? "")
+  const [phase, setPhase] = useState<Phase>("idle")
+  const [progress, setProgress] = useState({ done: 0, total: 0 })
+  const [error, setError] = useState("")
+  const [confirmResetOpen, setConfirmResetOpen] = useState(false)
+  const [resetting, setResetting] = useState(false)
+
+  const needsKey = provider.requiresApiKey && !provider.emptyApiKeyAllowed
+  const busy = phase !== "idle" || resetting
+  const hasStoredKey = providerModelIndex !== undefined
+  const reuseStoredKey = !apiKey.trim() && hasStoredKey
+  const canConnect = !needsKey || apiKey.trim().length > 0 || hasStoredKey
+
+  useEffect(() => {
+    setApiKey("")
+    setApiBase(provider.defaultApiBase ?? "")
+    setPhase("idle")
+    setProgress({ done: 0, total: 0 })
+    setError("")
+    setConfirmResetOpen(false)
+    setResetting(false)
+  }, [provider])
+
+  const handleReset = useCallback(async () => {
+    setResetting(true)
+    try {
+      await deleteProvider(provider.key)
+      toast.success(
+        t("providers.reset.done", {
+          count: modelCount,
+          provider: provider.label,
+        }),
+      )
+      onSaved()
+      onClose()
+    } catch (e) {
+      toast.error(e instanceof Error ? e.message : t("providers.reset.error"))
+    } finally {
+      setResetting(false)
+      setConfirmResetOpen(false)
+    }
+  }, [modelCount, onClose, onSaved, provider, t])
+
+  const handleConnect = useCallback(async () => {
+    if (busy) return
+    setError("")
+    setPhase("fetching")
+
+    let upstream: UpstreamModel[]
+    try {
+      if (provider.supportsFetch) {
+        const res = await fetchUpstreamModels({
+          provider: provider.key,
+          api_key: apiKey.trim(),
+          api_base: apiBase.trim() || provider.defaultApiBase || undefined,
+          model_index: reuseStoredKey ? providerModelIndex : undefined,
+        })
+        upstream = res.models
+      } else {
+        upstream = provider.commonModels.map((id) => ({ id }))
+      }
+    } catch (e) {
+      if (provider.commonModels.length > 0) {
+        upstream = provider.commonModels.map((id) => ({ id }))
+        toast.info(
+          t("providers.sheet.knownModelsHint", {
+            count: provider.commonModels.length,
+          }),
+        )
+      } else {
+        setPhase("idle")
+        setError(
+          e instanceof Error ? e.message : t("providers.sheet.fetchFailed"),
+        )
+        return
+      }
+    }
+
+    const newModels = upstream.filter(
+      (m) => m.id && !existingModelIDs.has(m.id),
+    )
+    if (newModels.length === 0) {
+      setPhase("idle")
+      toast.info(
+        upstream.length === 0
+          ? t("providers.sheet.noModelsFound")
+          : t("providers.sheet.noneNew"),
+      )
+      return
+    }
+
+    setPhase("adding")
+    setProgress({ done: 0, total: newModels.length })
+    let added = 0
+    let failed = 0
+    for (const model of newModels) {
+      try {
+        await addModel({
+          model_name: model.id,
+          provider: provider.key,
+          model: model.id,
+          api_key: apiKey.trim() || undefined,
+          api_base: apiBase.trim() || provider.defaultApiBase || undefined,
+          inherit_api_key_from: reuseStoredKey ? providerModelIndex : undefined,
+        })
+        added += 1
+      } catch {
+        failed += 1
+      }
+      setProgress((prev) => ({ ...prev, done: prev.done + 1 }))
