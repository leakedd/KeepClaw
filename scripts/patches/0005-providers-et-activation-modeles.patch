+// handleSetModelChat toggles whether a single model is offered in the Chat
+// model picker. The models list returns a masked API key, so a full update
+// round-trip would persist the mask; this endpoint only touches the flag.
+//
+//	POST /api/models/{index}/chat
+func (h *Handler) handleSetModelChat(w http.ResponseWriter, r *http.Request) {
+	idx, err := strconv.Atoi(r.PathValue("index"))
+	if err != nil {
+		http.Error(w, "Invalid index", http.StatusBadRequest)
+		return
+	}
+
+	var body struct {
+		InChat *bool `json:"in_chat"`
+	}
+	if err = json.NewDecoder(io.LimitReader(r.Body, 1<<20)).Decode(&body); err != nil || body.InChat == nil {
+		http.Error(w, `Invalid JSON: expected {"in_chat": true|false}`, http.StatusBadRequest)
+		return
+	}
+	defer r.Body.Close()
+
+	h.configMu.Lock()
+	defer h.configMu.Unlock()
+
+	cfg, err := config.LoadConfig(h.configPath)
+	if err != nil {
+		http.Error(w, fmt.Sprintf("Failed to load config: %v", err), http.StatusInternalServerError)
+		return
+	}
+	normalizeStoredModelProviders(cfg)
+
+	if idx < 0 || idx >= len(cfg.ModelList) {
+		http.Error(w, fmt.Sprintf("Index %d out of range (0-%d)", idx, len(cfg.ModelList)-1), http.StatusNotFound)
+		return
+	}
+
+	if !*body.InChat {
+		defaultModel := strings.TrimSpace(cfg.Agents.Defaults.GetModelName())
+		if defaultModel != "" && strings.TrimSpace(cfg.ModelList[idx].ModelName) == defaultModel {
+			http.Error(w, "Cannot remove the default model from chat; switch the default first", http.StatusBadRequest)
+			return
+		}
+	}
+
+	cfg.ModelList[idx].ChatDisabled = !*body.InChat
+	if err = config.SaveConfig(h.configPath, cfg); err != nil {
+		http.Error(w, fmt.Sprintf("Failed to save config: %v", err), http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(map[string]any{
+		"status":        "ok",
+		"index":         idx,
+		"in_chat":       *body.InChat,
+		"chat_disabled": !*body.InChat,
+	})
+}
+
+// handleDeleteProvider removes every model entry of a provider, which clears
+// the stored API key and resets the provider to an unconfigured state.
+//
+//	DELETE /api/providers/{provider}
+func (h *Handler) handleDeleteProvider(w http.ResponseWriter, r *http.Request) {
+	target := providers.NormalizeProvider(strings.TrimSpace(r.PathValue("provider")))
+	if target == "" {
+		http.Error(w, "provider is required", http.StatusBadRequest)
+		return
+	}
+
+	h.configMu.Lock()
+	defer h.configMu.Unlock()
+
+	cfg, err := config.LoadConfig(h.configPath)
+	if err != nil {
+		http.Error(w, fmt.Sprintf("Failed to load config: %v", err), http.StatusInternalServerError)
+		return
+	}
+	normalizeStoredModelProviders(cfg)
+
+	kept := make([]*config.ModelConfig, 0, len(cfg.ModelList))
+	removed := 0
+	for _, model := range cfg.ModelList {
+		provider, _ := providers.ExtractProtocol(model)
+		if providers.NormalizeProvider(provider) == target {
+			removed++
+			continue
+		}
+		kept = append(kept, model)
+	}
+	if removed == 0 {
+		http.Error(w, fmt.Sprintf("No model found for provider %q", target), http.StatusNotFound)
+		return
+	}
+
+	cfg.ModelList = kept
+	normalizeStoredModelNames(cfg)
+
+	remainingModels := modelConfigsByName(cfg)
+	if name := strings.TrimSpace(cfg.Agents.Defaults.ModelName); name != "" {
+		if err := validateDefaultChainModelSet(name, remainingModels[name], true, defaultChainProvider(cfg)); err != nil {
+			cfg.Agents.Defaults.ModelName = ""
+		}
+	}
+	if len(cfg.Agents.Defaults.ModelFallbacks) > 0 {
+		fallbacks := make([]string, 0, len(cfg.Agents.Defaults.ModelFallbacks))
+		for _, name := range cfg.Agents.Defaults.ModelFallbacks {
+			if err := validateDefaultChainModelSet(name, remainingModels[name], false, defaultChainProvider(cfg)); err == nil {
+				fallbacks = append(fallbacks, name)
+			}
+		}
+		cfg.Agents.Defaults.ModelFallbacks = fallbacks
+	}
+	normalizeDefaultChainReferences(cfg)
+
+	if err = config.SaveConfig(h.configPath, cfg); err != nil {
+		http.Error(w, fmt.Sprintf("Failed to save config: %v", err), http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(map[string]any{
+		"status":  "ok",
+		"removed": removed,
+	})
+}
